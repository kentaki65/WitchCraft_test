{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2015",
    "noEmit": false,
    "noLib": false,
    "skipLibCheck": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "paths": {
      "*": ["./*"],
      "@bloxd": ["./node_modules/@bloxd/index.d.ts"],
      "@plugins/debug": ["./node_modules/@plugins/debug/index.d.ts"],
      "@plugins/dialogue": ["./node_modules/@plugins/dialogue/index.d.ts"],
      "@plugins/helpers": ["./node_modules/@plugins/helpers/index.d.ts"],
      "@plugins/sessionBasedGame": ["./node_modules/@plugins/sessionBasedGame/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts", 
    "index.ts"  
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "files": [
    "node_modules/@bloxd/globals.d.ts",
    "node_modules/@bloxd/lib.d.ts"
  ]
}