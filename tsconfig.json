{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"strict": false,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noLib": false,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": {
			"@bloxd": [
				"./node_modules/@bloxd/index.d.ts"
			]
		}
	},
	"include": [
		"./**/*.ts",
		"./**/*.js",
		"./**/*.d.ts"
	],
	"files": [
		"node_modules/@bloxd/globals.d.ts",
		"node_modules/@bloxd/lib.d.ts"
	]
}
